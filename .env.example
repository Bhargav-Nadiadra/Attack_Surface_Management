# Copy to .env and fill in real values. Never commit .env.
# Every variable below is REQUIRED unless marked optional - the app will not start without it.

# Application
APP_NAME=ASM Asset Discovery Service
LOG_LEVEL=INFO

# Database (sync SQLAlchemy + psycopg v3).
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/asm_db
DB_CONNECT_TIMEOUT_SECONDS=3

# JWT - replace with a long random value:
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Login rate limit: failed login attempts allowed per client IP per window
LOGIN_RATE_LIMIT_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# First admin (seeded only when no users exist)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# DNS discovery timeout per record type (seconds)
DNS_TIMEOUT_SECONDS=5
# Optional: comma-separated resolver IPs for discovery; empty uses the system resolver.
# docker compose defaults this to 1.1.1.1,8.8.8.8 because Docker's built-in DNS drops AAAA answers.
DNS_NAMESERVERS=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# Optional: leave empty to reuse REDIS_URL
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Scan task time limits (seconds)
SCAN_SOFT_TIME_LIMIT_SECONDS=90
SCAN_TIME_LIMIT_SECONDS=120

# Stale-scan sweeper
SWEEP_INTERVAL_SECONDS=60
STALE_PENDING_MINUTES=2
STALE_RUNNING_MINUTES=10
